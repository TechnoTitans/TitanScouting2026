<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/endgame2"
    tools:context=".views.Endgame" >

    <CheckBox
        android:id="@+id/pins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@id/penalties"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="0.55"
        app:layout_constraintVertical_bias="0.39" />

    <CheckBox
        android:id="@+id/steals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintTop_toTopOf="@id/pins"
        app:layout_constraintLeft_toLeftOf="@id/pins"
        app:layout_constraintRight_toRightOf="@id/pins"
        app:layout_constraintBottom_toTopOf="@id/rams"
        app:layout_constraintVertical_bias="0.6" />

    <CheckBox
        android:id="@+id/blocks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@id/rams"
        app:layout_constraintLeft_toLeftOf="@id/pins"
        app:layout_constraintRight_toRightOf="@id/pins"
        app:layout_constraintTop_toBottomOf="@id/pins"
        app:layout_constraintVertical_bias="0.4" />

    <CheckBox
        android:id="@+id/rams"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/pins"
        app:layout_constraintRight_toRightOf="@id/pins"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.62" />

    <CheckBox
        android:id="@+id/penalties"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2" />

    <CheckBox
        android:id="@+id/brokeDown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintRight_toRightOf="@id/penalties"
        app:layout_constraintLeft_toLeftOf="@id/penalties"
        app:layout_constraintTop_toBottomOf="@id/penalties"
        app:layout_constraintBottom_toTopOf="@id/trench"/>

    <CheckBox
        android:id="@+id/trench"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintRight_toRightOf="@id/penalties"
        app:layout_constraintLeft_toLeftOf="@id/penalties"
        app:layout_constraintTop_toBottomOf="@id/brokeDown"
        app:layout_constraintBottom_toTopOf="@id/bump"/>

    <CheckBox
        android:id="@+id/bump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintLeft_toLeftOf="@id/penalties"
        app:layout_constraintRight_toRightOf="@id/penalties"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.664" />

    <RatingBar
        android:id="@+id/defenseRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="0.63"
        android:scaleY="0.385"
        android:stepSize="1.0"
        app:layout_constraintLeft_toRightOf="@id/penalties"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintTop_toTopOf="@id/brokeDown"
        app:layout_constraintBottom_toBottomOf="@id/trench"
        app:layout_constraintVertical_bias="0.65"/>

    <RatingBar
        android:id="@+id/climb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="3"
        android:scaleX="0.8"
        android:scaleY="0.385"
        android:stepSize="1.0"
        app:layout_constraintTop_toBottomOf="@id/rams"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@id/rams"
        app:layout_constraintVertical_bias="0.22"
        app:layout_constraintHorizontal_bias="0.8"/>

    <RatingBar
        android:id="@+id/climbLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:stepSize="1.0"
        android:scaleX="0.8"
        android:scaleY="0.385"
        android:numStars="3"
        app:layout_constraintLeft_toLeftOf="@id/climb"
        app:layout_constraintRight_toRightOf="@id/climb"
        app:layout_constraintTop_toTopOf="@id/climb"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.65"/>

    <EditText
        android:id="@+id/comments"
        android:layout_width="209dp"
        android:layout_height="103dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.913"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.873" />

    <Button
        android:id="@+id/to_summary"
        android:layout_width="284dp"
        android:layout_height="99dp"
        android:alpha="0"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/back_to_teleop"
        app:layout_constraintBottom_toBottomOf="@id/back_to_teleop"/>

    <Button
        android:id="@+id/back_to_teleop"
        android:layout_width="284dp"
        android:layout_height="99dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.063" />
</androidx.constraintlayout.widget.ConstraintLayout>