<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <TextView
            android:id="@+id/summary_match_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MATCH #—"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/summary_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:background="#1A1A1A"
                android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/summary_team_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Team: —"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"/>

            <TextView
                android:id="@+id/summary_scouter_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scout: —"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="center_vertical"/>
        </LinearLayout>

        <View
            android:id="@+id/header_divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#444444"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>

        <!-- PREGAME -->
        <TextView style="@style/SectionHeader" android:text="── PREGAME" android:textColor="#888888" android:background="#111111"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="10sp" android:letterSpacing="0.2"
            android:paddingStart="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginBottom="2dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#0F0F0F"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="NO SHOW" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_no_show" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- AUTONOMOUS -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="── AUTONOMOUS" android:textColor="#B060FF" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.2" android:background="#150D1F"
            android:paddingStart="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginBottom="2dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#0F0F0F"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DEPOT" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_depot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CLIMB" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_climb_auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="COLLECTED FUEL" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_collected_fuel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SCORED" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_scored" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WENT TO NEUTRAL" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_went_neutral" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- TELEOP -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="── TELEOP" android:textColor="#FF6B00" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.2" android:background="#1F1200"
            android:paddingStart="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginBottom="2dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#0F0F0F"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SHOT WHILE MOVING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_shot_while_moving" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A" android:layout_marginBottom="10dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SHOT HEATMAP" android:textColor="#666666" android:textSize="10sp"
                android:fontFamily="monospace" android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>

            <GridLayout
                android:id="@+id/shot_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rowCount="8"
                android:columnCount="8"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/val_shot_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 shots logged"
                android:textColor="#555555"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

        </LinearLayout>

        <!-- ENDGAME STATUS -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="── ENDGAME — STATUS" android:textColor="#00D4AA" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.2" android:background="#001F1A"
            android:paddingStart="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginBottom="2dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#0F0F0F"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PENALTIES" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_penalties" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BROKE DOWN" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_broke_down" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="USED TRENCH" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_trench" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="USED BUMP" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_bump" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="monospace" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ENDGAME RATINGS -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="── ENDGAME — RATINGS" android:textColor="#FFD700" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.2" android:background="#1F1A00"
            android:paddingStart="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginBottom="2dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#0F0F0F"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CLIMB" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_climb_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PINNING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_pinning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="STEALING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_stealing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BLOCKING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_blocking" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RAMMING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_ramming" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ANTI-PINNING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_anti_pin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ANTI-STEALING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_anti_steal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ANTI-BLOCKING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_anti_block" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A1A1A"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ANTI-RAMMING" android:textColor="#666666" android:textSize="11sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/val_anti_ram" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○○○○○  0/5" android:textColor="#555555" android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>

        </LinearLayout>

        <!-- NOTES -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="── SCOUT NOTES" android:textColor="#AAAAAA" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.2" android:background="#111111"
            android:paddingStart="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginBottom="2dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#0F0F0F"
            android:padding="12dp" android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/val_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.6"/>

        </LinearLayout>

        <!-- BACK BUTTON -->
        <Button
            android:id="@+id/summary_back_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="← BACK TO PREGAME"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>